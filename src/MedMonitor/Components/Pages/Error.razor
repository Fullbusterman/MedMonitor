@page "/Error"
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Ошибка — МедМонитор</PageTitle>

<div class="container mt-5">
    <div class="alert alert-danger">
        <h2>⚠️ Произошла ошибка</h2>
        <p>Приносим извинения. При обработке запроса возникла непредвиденная ошибка.</p>
        <a href="/" class="btn btn-outline-danger">← На главную</a>
    </div>
</div>
