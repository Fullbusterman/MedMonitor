@page "/patients"
@rendermode InteractiveServer
@inject IPatientService PatientService
@inject NavigationManager NavManager

<PageTitle>Пациенты — МедМонитор</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Пациенты</h1>
    <a href="patients/new" class="btn btn-success">➕ Добавить пациента</a>
</div>

<!-- Фильтры и поиск -->
<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Поиск по ФИО или полису..."
               @bind="searchTerm" @bind:event="oninput" @onkeyup="LoadPatients" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="statusFilter" @bind:after="LoadPatients">
            <option value="Все">Все статусы</option>
            <option value="Активный">Активный</option>
            <option value="Выписан">Выписан</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center my-4"><div class="spinner-border text-primary"></div></div>
}
else if (patients == null || !patients.Any())
{
    <div class="alert alert-info">Пациенты не найдены</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ФИО</th>
                    <th>Дата рождения</th>
                    <th>Пол</th>
                    <th>Полис</th>
                    <th>Диагноз</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in patients)
                {
                    <tr>
                        <td><a href="patients/@patient.Id">@patient.FullName</a></td>
                        <td>@patient.DateOfBirth.ToString("dd.MM.yyyy") <small class="text-muted">(@patient.Age лет)</small></td>
                        <td>@patient.Gender</td>
                        <td>@(patient.PolicyNumber ?? "—")</td>
                        <td>@(patient.Diagnoses?.Length > 40 ? patient.Diagnoses[..40] + "..." : patient.Diagnoses ?? "—")</td>
                        <td>
                            <span class="badge @(patient.Status == "Активный" ? "bg-success" : "bg-secondary")">
                                @patient.Status
                            </span>
                        </td>
                        <td>
                            <a href="patients/@patient.Id" class="btn btn-sm btn-outline-primary me-1">👁</a>
                            <a href="patients/@patient.Id/edit" class="btn btn-sm btn-outline-warning me-1">✏️</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(patient.Id, patient.FullName)">🗑</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Найдено пациентов: @patients.Count</p>
}

<!-- Модальное окно подтверждения удаления -->
@if (showDeleteModal)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Подтверждение удаления</h5>
                </div>
                <div class="modal-body">
                    Вы уверены, что хотите удалить пациента <strong>@deletePatientName</strong>?
                    Все данные о родственниках и показателях будут удалены.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showDeleteModal = false">Отмена</button>
                    <button class="btn btn-danger" @onclick="DeletePatient">Удалить</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Patient>? patients;
    private string searchTerm = "";
    private string statusFilter = "Все";
    private bool isLoading = true;
    private bool showDeleteModal = false;
    private int deletePatientId;
    private string deletePatientName = "";

    protected override async Task OnInitializedAsync() => await LoadPatients();

    private async Task LoadPatients()
    {
        isLoading = true;
        patients = await PatientService.GetAllPatientsAsync(searchTerm, statusFilter);
        isLoading = false;
    }

    private void ConfirmDelete(int id, string name)
    {
        deletePatientId = id;
        deletePatientName = name;
        showDeleteModal = true;
    }

    private async Task DeletePatient()
    {
        await PatientService.DeletePatientAsync(deletePatientId);
        showDeleteModal = false;
        await LoadPatients();
    }
}
