@page "/patients/{Id:int}"
@rendermode InteractiveServer
@inject IPatientService PatientService
@inject IVitalSignService VitalSignService
@inject IRelativeService RelativeService
@inject NavigationManager NavManager

<PageTitle>Карточка пациента — МедМонитор</PageTitle>

@if (patient == null)
{
    <div class="text-center my-5"><div class="spinner-border text-primary" style="width:3rem;height:3rem"></div></div>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-1">@patient.FullName</h1>
            <span class="badge fs-6 @(patient.Status == "Активный" ? "bg-success" : "bg-secondary")">
                @patient.Status
            </span>
            @if (patient.HasAllergies)
            {
                <span class="badge bg-danger ms-2 fs-6">⚠️ Аллергия</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a href="patients/@patient.Id/edit" class="btn btn-warning">✏️ Редактировать</a>
            <a href="patients" class="btn btn-outline-secondary">← Назад</a>
        </div>
    </div>

    <div class="row g-3">
        <!-- Личные данные -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">📋 Личные данные</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5">Дата рождения:</dt>
                        <dd class="col-7">@patient.DateOfBirth.ToString("dd.MM.yyyy") <span class="text-muted">(@patient.Age лет)</span></dd>
                        <dt class="col-5">Пол:</dt>
                        <dd class="col-7">@(patient.Gender == "М" ? "Мужской" : "Женский")</dd>
                        <dt class="col-5">Группа крови:</dt>
                        <dd class="col-7"><strong>@(patient.BloodType ?? "Не указана")</strong></dd>
                        <dt class="col-5">Полис ОМС:</dt>
                        <dd class="col-7">@(patient.PolicyNumber ?? "—")</dd>
                        <dt class="col-5">Телефон:</dt>
                        <dd class="col-7">@(patient.PhoneNumber ?? "—")</dd>
                        <dt class="col-5">Адрес:</dt>
                        <dd class="col-7">@(patient.Address ?? "—")</dd>
                        <dt class="col-5">Госпитализирован:</dt>
                        <dd class="col-7">@patient.AdmissionDate.ToString("dd.MM.yyyy")</dd>
                        @if (patient.DischargeDate.HasValue)
                        {
                            <dt class="col-5">Выписан:</dt>
                            <dd class="col-7">@patient.DischargeDate.Value.ToString("dd.MM.yyyy")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Медицинские данные -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-danger text-white">🏥 Медицинские данные</div>
                <div class="card-body">
                    <h6 class="fw-semibold">Диагнозы:</h6>
                    <p>@(patient.Diagnoses ?? "Не указаны")</p>
                    <h6 class="fw-semibold">Аллергии:</h6>
                    @if (patient.HasAllergies)
                    {
                        <div class="alert alert-warning py-2 mb-0">
                            <strong>⚠️</strong> @patient.AllergyDescription
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Не выявлены</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Родственники -->
    <div class="card mt-3">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span>👨‍👩‍👧 Ближайшие родственники (@patient.Relatives.Count)</span>
            <a href="patients/@patient.Id/relatives/new" class="btn btn-sm btn-light">+ Добавить</a>
        </div>
        <div class="card-body p-0">
            @if (!patient.Relatives.Any())
            {
                <p class="text-muted p-3 mb-0">Родственники не добавлены</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ФИО</th>
                                <th>Родство</th>
                                <th>Телефон</th>
                                <th>Email</th>
                                <th>Контакт</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rel in patient.Relatives.OrderByDescending(r => r.IsPrimaryContact))
                            {
                                <tr>
                                    <td>@rel.FullName</td>
                                    <td>@rel.Relationship</td>
                                    <td>@rel.PhoneNumber</td>
                                    <td>@(rel.Email ?? "—")</td>
                                    <td>@(rel.IsPrimaryContact ? "✅ Основной" : "")</td>
                                    <td>
                                        <a href="patients/@patient.Id/relatives/@rel.Id/edit"
                                           class="btn btn-xs btn-outline-warning btn-sm me-1">✏️</a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteRelative(rel.Id)">🗑</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Витальные показатели -->
    <div class="card mt-3">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <span>❤️ Показатели жизнедеятельности (последние @vitalSigns.Count)</span>
            <button class="btn btn-sm btn-light" @onclick="() => showAddVital = !showAddVital">
                @(showAddVital ? "✕ Отмена" : "+ Новое измерение")
            </button>
        </div>
        <div class="card-body">
            @if (showAddVital)
            {
                <div class="border rounded p-3 mb-3 bg-light">
                    <h6 class="mb-3">Новое измерение — @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</h6>
                    <div class="row g-2">
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">АД систол. <small class="text-muted">(мм рт.ст.)</small></label>
                            <input type="number" class="form-control form-control-sm" @bind="newVital.BloodPressureSystolic" min="60" max="250" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">АД диастол.</label>
                            <input type="number" class="form-control form-control-sm" @bind="newVital.BloodPressureDiastolic" min="40" max="150" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">Пульс <small class="text-muted">(уд/мин)</small></label>
                            <input type="number" class="form-control form-control-sm" @bind="newVital.HeartRate" min="30" max="250" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">Темп. <small class="text-muted">(°C)</small></label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="newVital.Temperature" min="35" max="43" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">SpO2 <small class="text-muted">(%)</small></label>
                            <input type="number" class="form-control form-control-sm" @bind="newVital.OxygenSaturation" min="50" max="100" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label form-label-sm">ЧД <small class="text-muted">(вд/мин)</small></label>
                            <input type="number" class="form-control form-control-sm" @bind="newVital.RespiratoryRate" min="6" max="60" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label form-label-sm">Примечания</label>
                            <input type="text" class="form-control form-control-sm" @bind="newVital.Notes" placeholder="Жалобы, наблюдения..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label form-label-sm">Зарегистрировал</label>
                            <input type="text" class="form-control form-control-sm" @bind="newVital.RecordedBy" placeholder="ФИО медработника" />
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm mt-3" @onclick="AddVitalSign">💾 Сохранить измерение</button>
                </div>
            }

            @if (!vitalSigns.Any())
            {
                <p class="text-muted">Показатели ещё не фиксировались</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Дата/Время</th>
                                <th>АД (мм рт.ст.)</th>
                                <th>Пульс</th>
                                <th>Темп. °C</th>
                                <th>SpO2 %</th>
                                <th>ЧД</th>
                                <th>Примечание</th>
                                <th>Регистратор</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in vitalSigns)
                            {
                                <tr>
                                    <td>@v.MeasuredAt.ToString("dd.MM.yy HH:mm")</td>
                                    <td class="@BpClass(v.BloodPressureSystolic)">@v.BloodPressureFormatted</td>
                                    <td class="@HrClass(v.HeartRate)">@(v.HeartRate?.ToString() ?? "—")</td>
                                    <td class="@TempClass(v.Temperature)">@(v.Temperature?.ToString("F1") ?? "—")</td>
                                    <td class="@Spo2Class(v.OxygenSaturation)">@(v.OxygenSaturation?.ToString() ?? "—")</td>
                                    <td>@(v.RespiratoryRate?.ToString() ?? "—")</td>
                                    <td>@(v.Notes ?? "")</td>
                                    <td><small class="text-muted">@(v.RecordedBy ?? "")</small></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteVitalSign(v.Id)">🗑</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Patient? patient;
    private List<VitalSign> vitalSigns = new();
    private bool showAddVital = false;
    private VitalSign newVital = new();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        patient = await PatientService.GetPatientByIdAsync(Id);
        if (patient != null)
            vitalSigns = await VitalSignService.GetVitalSignsByPatientIdAsync(Id);
    }

    private async Task AddVitalSign()
    {
        newVital.PatientId = Id;
        newVital.MeasuredAt = DateTime.UtcNow;
        await VitalSignService.AddVitalSignAsync(newVital);
        newVital = new VitalSign();
        showAddVital = false;
        vitalSigns = await VitalSignService.GetVitalSignsByPatientIdAsync(Id);
    }

    private async Task DeleteVitalSign(int vitalId)
    {
        await VitalSignService.DeleteVitalSignAsync(vitalId);
        vitalSigns = await VitalSignService.GetVitalSignsByPatientIdAsync(Id);
    }

    private async Task DeleteRelative(int relId)
    {
        await RelativeService.DeleteRelativeAsync(relId);
        patient = await PatientService.GetPatientByIdAsync(Id);
    }

    // Цветовая индикация
    private static string BpClass(int? s) => s switch { > 160 => "fw-bold text-danger", > 140 => "fw-bold text-warning", _ => "" };
    private static string HrClass(int? h) => h switch { > 100 or < 50 => "fw-bold text-danger", > 90 => "fw-bold text-warning", _ => "" };
    private static string TempClass(decimal? t) => t switch { > 38.5m => "fw-bold text-danger", > 37.5m => "fw-bold text-warning", _ => "" };
    private static string Spo2Class(int? s) => s switch { < 90 => "fw-bold text-danger", < 95 => "fw-bold text-warning", _ => "" };
}
